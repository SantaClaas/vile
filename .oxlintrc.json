{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Strict on purpose (see Formatting and linting in docs/guidelines/typescript.md). Where a rule doesn't
  // apply to one line, disable it there with a reason after "--"; require-reason checks that.
  // Type-aware rules (floating promises, unsafe any and so on) need oxlint-tsgolint.
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest", "node"],
  "jsPlugins": ["./oxlint-plugins/index.ts"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "vile/require-reason": "error",
    // Return early instead (see Functions in docs/guidelines/principles.md).
    "vile/no-else": "error",
    // A ternary chooses between two values; a third choice reads better as an early return
    // (see "Choosing between two values" in docs/guidelines/principles.md).
    "no-nested-ternary": "error",
    // A catch handles one operation's failure, never a mistake around it (see Functions in
    // docs/guidelines/principles.md).
    "vile/one-operation-per-try": "error",
    // A cleanup that runs however a scope ends is a using declaration (see Functions in
    // docs/guidelines/principles.md).
    "vile/prefer-using": "error",
    // A using declaration that's only there to clean up when its scope ends is never read, and
    // TypeScript only allows that when its name starts with "_" (as in `using _ending`). Elsewhere a
    // leading or trailing underscore stays an error; parameters like `_before` are allowed already.
    "no-underscore-dangle": ["error", { "allowInUsingDeclarations": true }],
    // The shorter of two branches goes inside the if (see Functions in
    // docs/guidelines/principles.md).
    "vile/shorter-branch-first": "error",
    // Everything is declared above its first use, as in F#, so a file reads bottom-up: types and
    // helpers first, the module's entry point last (see Functions in
    // docs/guidelines/principles.md). Type references count too.
    "no-use-before-define": [
      "error",
      {
        "functions": true,
        "classes": true,
        "variables": true,
        "typedefs": true,
        "enums": true,
        "ignoreTypeReferences": false,
        "allowNamedExports": false
      }
    ],
    // No type assertions: `as` and `<T>` are errors, and `!` too. A checked value comes from a
    // sanitizer or a type guard instead. `as const` is still allowed.
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/no-non-null-assertion": "error",
    // Covered by the rule above, which already makes every assertion an explained exception.
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false,
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/explicit-module-boundary-types": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    // Asks for deeply readonly parameters, which Node's and libraries' objects can't be. Arrays that
    // must not change are `readonly` in their types instead.
    "typescript/prefer-readonly-parameter-types": "off",
    // Modules are split by meaning, not by size (see Modules in docs/guidelines/principles.md), so
    // limits on lines, functions, classes or imports would push splits for the wrong reason.
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-classes-per-file": "off",
    "import/max-dependencies": "off",
    // Imports name the file in full, as Node's type stripping needs, in every file and not only
    // the ones Node runs, so any module could run there as it is (see Formatting and linting in
    // docs/guidelines/typescript.md).
    "import/extensions": ["error", "always", { "ignorePackages": true }]
  },
  "env": {
    "builtin": true,
    "node": true
  },
  // The fixture projects are written to give known mutants, not to follow our rules (see
  // fixtures/README.md); their expectations' own test is linted.
  "ignorePatterns": ["target/**", "vile.out/**", "fixtures/*/**"],
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        // The scripts work through files one at a time on purpose, so the output is the same on
        // every run.
        "no-await-in-loop": "off"
      }
    }
  ]
}
